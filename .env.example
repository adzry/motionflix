# MotionFlix environment variables
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Nothing in the Phase 1 foundation reads these yet; they are listed so later
# phases have a single, documented contract. All values below are placeholders.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL (used for auth redirects). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed to sign in. MotionFlix is a private,
# single-owner library; everyone else is rejected after authentication.
MOTIONFLIX_ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Supabase (Auth + Postgres) — Phase 2/3
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (formerly "anon") key — safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Secret (formerly "service_role") key — SERVER ONLY, bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Only add it if a server task truly needs it.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# ---------------------------------------------------------------------------
# Cloudflare R2 (private media storage) — Phase 4
# Dashboard → R2 → Manage R2 API Tokens (scope the token to one bucket)
# All R2 values are SERVER ONLY.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=motionflix-media
# S3-compatible endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Lifetime of presigned playback / upload URLs, in seconds.
R2_SIGNED_URL_TTL_SECONDS=3600
